{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plain Notes",
  "version": "0.1.0",
  "identifier": "com.ianguimaraes.plain-notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 420,
        "height": 520,
        "minWidth": 340,
        "minHeight": 200,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "transparent": true,
        "shadow": true,
        "focus": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["bin/plain-notes-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
